{
  "name": "rightstack",
  "version": "0.3.2",
  "description": "AI-native web3 stack intelligence CLI",
  "bin": {
    "rightstack": "./bin/rightstack.js",
    "rightstack-mcp": "./bin/rightstack-mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "data"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build && rm -rf ./data && cp -r ../../data ./data",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.6"
  }
}
